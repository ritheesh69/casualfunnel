# Copy to .env and fill in. Never commit the real .env file.

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Include a database name, e.g. /user_analytics
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/user_analytics?retryWrites=true&w=majority

# Port the API listens on (Render sets PORT automatically).
PORT=4000

# Comma-separated list of origins allowed to call the API from a browser:
# the dashboard and every site that embeds tracker.js.
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Max POST /api/events requests per IP per minute.
RATE_LIMIT_PER_MINUTE=300

# Optional: separate database used only by `npm test` integration tests.
# Tests that need a database are skipped when this is unset.
# The tests delete every document in this database, so never point it at real data.
TEST_MONGODB_URI=
